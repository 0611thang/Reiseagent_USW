# Groq Chat/LLM
GROQ_API_KEY=

# OpenRouteService Navigation
ORS_API_KEY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenTripMap Places/POI API
OPENTRIPMAP_API_KEY=

# Flight API / Aviationstack
FLIGHT_API_URL=https://api.aviationstack.com/v1/flights
FLIGHT_API_KEY=
FLIGHT_API_AUTH_MODE=query
FLIGHT_NUMBER=
MOCK_FLIGHT_DELAY_MINUTES=0

# Background monitoring
MONITORING_INTERVAL_SECONDS=1800

# Optional Gemini chat configuration
GEMINI_CHAT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_DAILY_REQUEST_LIMIT=1500

# Default city for local suggestions
HOME_CITY=Berlin

# Google Gmail / Calendar
# Put credentials.json next to this file if you want to use Gmail or Calendar.
# The app creates token.json and calendar_token.json locally after login.

# Open-Meteo and Nominatim do not need API keys.
