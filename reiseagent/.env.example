# Anthropic Claude API (optional – ohne Key wird regelbasierter Fallback genutzt)
ANTHROPIC_API_KEY=your_key_here

# OpenTripMap API (optional – ohne Key werden Mock-Daten genutzt)
# Kostenlosen Key unter https://opentripmap.io registrieren
OPENTRIPMAP_API_KEY=your_key_here

# Open-Meteo und Nominatim brauchen keinen API-Key
